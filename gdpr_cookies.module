<?php
/**
 * @file
 *
 * Hooks and main functions for GDPR Cookies.
 */

require_once('includes/Entity/ThirdPartyServiceEntityInterface.php');

/**
 * Implements hook_init().
 */
function gdpr_cookies_init() {

  require_once("includes/CookiesFactory.php");

  backdrop_add_library('gdpr_cookies', 'tarteaucitron', TRUE);

  $config = config('gdpr_cookies.settings');
  $privacy_link_setting = $config->get('gdpr_cookies_privacy_link');
  if (!empty($privacy_link_setting)) {
    $nid = gdpr_cookies_node_autocomplete_validate($privacy_link_setting);
    $privacy_url = '/' . backdrop_get_path_alias('node/' . $nid);
  }
  else {
    $privacy_url = '';
  }
  backdrop_add_js(array(
    'gdpr_cookies' => array(
      'hashtag' => $config->get('gdpr_cookies_hashtag'),
      'highPrivacy' => $config->get('gdpr_cookies_high_privacy'),
      'orientation' => $config->get('gdpr_cookies_orientation'),
      'adblocker' => $config->get('gdpr_cookies_adblocker'),
      'showAlertSmall' => $config->get('gdpr_cookies_show_alert_small'),
      'cookieslist' => $config->get('gdpr_cookies_cookieslist'),
      'removeCredit' => $config->get('gdpr_cookies_remove_credit'),
      'defaultRejected' => $config->get('gdpr_cookies_default_rejected'),
      'privacyUrl' => $privacy_url,
    ),
  ), 'setting');

  // Add style modifications for Backdrop.
  backdrop_add_css(backdrop_get_path('module', 'gdpr_cookies') . '/css/gdpr_cookies.css');
}

/**
 * Implements hook_exit().
 */
function gdpr_cookies_exit() {
  // Get current path value.
  $current_path = function_exists('current_path') ? current_path() : $_GET['q'];

  // The content type of the page must be text/html to proceed. All other
  // content types must be ignored - the name of the module is minifyhtml
  // after all.
  // Make sure to exclude image style images (is this even required anymore??).
  // Make sure the buffer has a length.
  $http_header = backdrop_get_http_header('content-type');
  if (isset($http_header) && stripos($http_header, 'text/html') !== FALSE && !is_file($current_path) && ob_get_length()) {

    // Catch the output buffer. Converted from ob_get_clean().
    $page = ob_get_contents();

    // If the content should be encoded, try to decode it.
    $decoded = FALSE;
    $page_compression_config = config_get('gdpr_cookies.settings', 'gdpr_cookies_page_compression');
    if ($page_compression_config && extension_loaded('zlib')) {
      $decoded = @gzinflate(substr(substr($page, 10), 0, -8));
      if ($decoded) {
        $page = $decoded;
      }
    }

    $factory = new CookiesFactory();
    $vanisher = $factory->createThirdPartyServicesVanisher();
    $page = $vanisher->vanish($page);

    // If the content was decoded before being minified, it needs to be
    // re-encoded.
    if ($page_compression_config && extension_loaded('zlib') && $decoded) {
      $page = gzencode($page, 9, FORCE_GZIP);
    }

    // Re-populate the output buffer.
    ob_clean();
    print $page;
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function gdpr_cookies_module_implements_alter(&$implementations, $hook) {

  // Move this module's hook_exit() to the end of the call order.
  if ($hook == 'exit' && isset($implementations['gdpr_cookies'])) {
    $group = $implementations['gdpr_cookies'];
    unset($implementations['gdpr_cookies']);
    $implementations['gdpr_cookies'] = $group;
  }
}

